diff -ruN a/src/render/terrainPieces.ts b/src/render/terrainPieces.ts
--- a/src/render/terrainPieces.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/render/terrainPieces.ts	2026-10-13 02:07:39.967574800 +0000
@@ -0,0 +1,74 @@
+// WHAT THIS FILE DOES
+// Stands the Modular Terrain Pack pieces chosen by sim/terrainKit.ts on the ground. Each model is
+// loaded once and drawn with "thin instances" (one draw call per material, however many copies),
+// so thousands of cliff, beach, slope and rock pieces stay cheap. The pieces keep the pack's own
+// geometry and materials; only position, turn and (for slope strips) height stretch are applied.
+// When a building edits the ground, pieces on or beside the edited tiles are hidden (see hidePieces)
+// so nothing is left floating or buried.
+import type { Scene } from '@babylonjs/core/scene'
+import { Mesh } from '@babylonjs/core/Meshes/mesh'
+import '@babylonjs/core/Meshes/thinInstanceMesh' // needed for thin instances to work
+import { loadModel } from './assetLoader'
+import { pieceMatrix } from './pieceMatrix'
+import { models } from '../assets'
+import type { EditBounds } from '../sim/terrainEdit'
+import type { Terrain, TerrainPiece } from '../sim/terrain'
+
+interface Batch {
+  mesh: Mesh
+  data: Float32Array
+  pieces: TerrainPiece[]
+}
+const batches: Batch[] = []
+
+async function spawnGroup(scene: Scene, id: string, list: TerrainPiece[]) {
+  const { meshes } = await loadModel(scene, id)
+  for (const m of meshes) {
+    if (!(m instanceof Mesh) || m.getTotalVertices() === 0) continue
+    const world = m.computeWorldMatrix(true).clone()
+    const inverse = world.clone().invert()
+    const data = new Float32Array(list.length * 16)
+    list.forEach((p, n) => pieceMatrix(world, inverse, p).copyToArray(data, n * 16))
+    m.thinInstanceSetBuffer('matrix', data, 16, false) // false = we will update it (pieces can be hidden)
+    m.thinInstanceRefreshBoundingInfo(true)
+    m.alwaysSelectAsActiveMesh = true // one batch spans the whole map; its box is always on screen somewhere
+    m.isPickable = false
+    batches.push({ mesh: m, data, pieces: list })
+  }
+}
+
+export async function spawnTerrainPieces(scene: Scene, t: Terrain) {
+  batches.length = 0
+  const groups = new Map<string, TerrainPiece[]>()
+  for (const p of t.pieces ?? []) {
+    if (!(p.id in models)) continue // file missing from src/assets/models: skip it
+    const list = groups.get(p.id) ?? []
+    list.push(p)
+    groups.set(p.id, list)
+  }
+  for (const [id, list] of groups) {
+    try {
+      await spawnGroup(scene, id, list)
+    } catch (err) {
+      console.error(`terrain piece ${id} failed:`, err)
+    }
+  }
+}
+
+/** After the ground under (and beside) a building changed, hide the pack pieces that no longer fit it. */
+export function hidePieces(t: Terrain, b: EditBounds) {
+  const half = t.size / 2
+  for (const batch of batches) {
+    let changed = false
+    batch.pieces.forEach((p, n) => {
+      // slope strips can reach 4 tiles from their centre; everything else stays within a tile or two
+      const margin = p.id.startsWith('Hilly_Terrain') ? 4 : 1.5
+      if (p.x < b.i0 - half - margin || p.x > b.i1 - half + margin) return
+      if (p.z < b.j0 - half - margin || p.z > b.j1 - half + margin) return
+      batch.data.fill(0, n * 16, n * 16 + 16)
+      batch.data[n * 16 + 15] = 1 // scale 0 everywhere: nothing is drawn
+      changed = true
+    })
+    if (changed) batch.mesh.thinInstanceBufferUpdated('matrix')
+  }
+}
