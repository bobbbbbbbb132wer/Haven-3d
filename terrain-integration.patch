+++ b/src/render/pieceMatrix.ts	2026-10-13 02:07:39.967821120 +0000
@@ -0,0 +1,18 @@
+// WHAT THIS FILE DOES
+// The one bit of maths behind placing a terrain piece: turns a piece's position / turn / size into
+// the matrix a thin instance needs. Kept on its own (no model loading) so it can be tested alone.
+import { Axis } from '@babylonjs/core/Maths/math.axis'
+import { Matrix, Quaternion, Vector3 } from '@babylonjs/core/Maths/math.vector'
+import type { TerrainPiece } from '../sim/terrain'
+
+/** The thin-instance matrix that puts a model's sub-mesh where `p` says, as a world-space placement. */
+export function pieceMatrix(world: Matrix, worldInverse: Matrix, p: TerrainPiece): Matrix {
+  const place = Matrix.Compose(
+    new Vector3(p.scale, p.scale * p.scaleY, p.scale),
+    Quaternion.RotationAxis(Axis.Y, p.yaw),
+    new Vector3(p.x, p.y, p.z),
+  )
+  // Thin instances are applied BEFORE the mesh's own world matrix. The glTF importer puts a mirror
+  // on the model's root, so wrap the placement in it: (mesh -> world) then place, expressed locally.
+  return world.multiply(place).multiply(worldInverse)
+}
